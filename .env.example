# Standalone / Amplify root build: baked API base for the dashboard.
VITE_API_URL=http://localhost:5312

# Same-origin /console build (auth-instance): serve the dashboard under /console
# on the auth API's own domain. Set by the `build:console` script; shown here for
# reference. When VITE_SAME_ORIGIN is true, the API base is derived from the
# page origin and VITE_API_URL is ignored.
# VITE_BASE_PATH=/console/
# VITE_SAME_ORIGIN=true
