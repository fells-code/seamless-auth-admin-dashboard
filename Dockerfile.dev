# Pinned by multi-arch digest for reproducible builds. Refresh with:
# docker buildx imagetools inspect node:24-slim (copy the top-level Digest).
FROM node:24-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm install

COPY . .

ENV NODE_ENV=development

EXPOSE 5173

CMD ["npm", "run", "dev"]